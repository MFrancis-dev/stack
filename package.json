{
  "name": "stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "demo": "tsx scripts/seed-demo.ts && next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check-env": "tsx scripts/check-env.ts",
    "contracts:build": "bash scripts/build-contracts.sh",
    "contracts:test": "cd contracts && cargo test"
  },
  "//": "Exact versions pinned 2026-11-04 (S0.4 / K0.4). Wallet + NEAR JS packages are added after S0.14 / K0.13 verification.",
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@electric-sql/pglite": "0.2.17",
    "@tanstack/react-query": "5.105.3",
    "drizzle-orm": "0.36.4",
    "nanoid": "5.1.16",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
